# Optional provider usage adapters. Copy the values into the environment that
# launches Start-Claude-Code-White.ps1. Keys are read only by the local bridge.
#
# DEEPSEEK_API_KEY also acts as a DeepSeek inference provider credential
# (precedence: this-session key configured in the UI > environment > Windows store).
# You can also configure the DeepSeek key from the CCW settings UI, which supports
# Windows DPAPI secure saving or session-only storage.
DEEPSEEK_API_KEY=
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=
GEMINI_API_KEY=
